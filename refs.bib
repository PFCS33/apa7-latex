% Sample references showing common APA reference types.
% Titles are converted to sentence case: wrap acronyms and proper nouns in
% braces to keep their capitals, e.g. {DOI} or {Purdue}.
% Replace these with your own sources.

% Journal article with DOI
@article{smith2021,
  author  = {Smith, Jane A. and Lee, Robert B.},
  title   = {A placeholder title for a journal article},
  journaltitle = {Journal of Placeholder Studies},
  volume  = {12},
  number  = {3},
  pages   = {45--67},
  date    = {2021},
  doi     = {10.1234/jps.2021.0123}
}

% Journal article with three authors and no DOI
% (cited in text as "Kim et al., 2017")
@article{kim2017,
  author       = {Kim, Daniel H. and Patel, Priya and Okafor, Chinedu},
  title        = {A placeholder title for an article without a {DOI}},
  journaltitle = {Placeholder Review of Education},
  volume       = {8},
  number       = {2},
  pages        = {19--36},
  date         = {2017}
}

% Book
@book{nguyen2019,
  author    = {Nguyen, Minh T.},
  title     = {A placeholder title for a book},
  edition   = {2},
  publisher = {Example Academic Press},
  date      = {2019}
}

% Chapter in an edited book
@incollection{garcia2018,
  author    = {Garcia, Ana L.},
  title     = {A placeholder title for a book chapter},
  editor    = {Brown, Kevin P. and White, Laura M.},
  booktitle = {A placeholder title for an edited book},
  pages     = {101--125},
  publisher = {Example University Press},
  date      = {2018}
}

% Web page
@online{who2023,
  author  = {{World Health Organization}},
  title   = {A placeholder title for a web page},
  date    = {2023-03-15},
  url     = {https://www.who.int/},
  urldate = {2024-01-10}
}

% Report by a group author (publisher omitted because it is the same as the author)
@report{apa2020,
  author      = {{American Psychological Association}},
  title       = {A placeholder title for a report},
  type        = {Technical Report},
  number      = {7},
  date        = {2020}
}

% Web page by a group author with no date (date omitted, printed as "n.d.")
@online{unesco,
  author  = {{United Nations Educational, Scientific and Cultural Organization}},
  title   = {A placeholder title for an undated web page},
  url     = {https://www.unesco.org/}
}
